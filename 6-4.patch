+        ("http://example.com?a=1&a=2", "a", True),
+        ("http://example.com?a=1&b=2&a=3", "a", True),
+        ("http://example.com?a=1&b=2", "b", False),
+        ("http://example.com?a=1&b=2&b=3&b=4", "b", True),
+    ],

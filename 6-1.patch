@@ -0,0 +1,35 @@
+import pytest
+
+from yarl import URL
+
+
+@pytest.mark.parametrize(
+    ("url", "query_param", "expected_present", "expected_count"),
+    [
+        (URL("http://example.com"), "a", False, 0),
+        (URL("http://example.com?a=1"), "a", True, 1),
+        (URL("http://example.com?a=1&a=2&b=3"), "a", True, 2),
+        (URL("http://example.com?a=1&a=2&b=3"), "b", True, 1),
+        (URL("http://example.com?%D0%BA%D0%BB=1&%D0%BA%D0%BB=2"), "кл", True, 2),
+        (URL("http://example.com?a=&a=2"), "a", True, 2),
+    ],
+)
+def test_query_param_helpers(
+    url: URL, query_param: str, expected_present: bool, expected_count: int
+) -> None:
+    original_query_string = url.query_string
+
+    assert url.has_query_param(query_param) is expected_present
+    assert url.query_param_count(query_param) == expected_count
+    assert url.query_string == original_query_string
+
+
+@pytest.mark.parametrize("query_param", [None, 1])
+def test_query_param_helpers_reject_non_str(query_param: object) -> None:
+    url = URL("http://example.com?a=1")
+
+    with pytest.raises(TypeError, match="Invalid query parameter type"):
+        url.has_query_param(query_param)  # type: ignore[arg-type]
+
+    with pytest.raises(TypeError, match="Invalid query parameter type"):
+        url.query_param_count(query_param)  # type: ignore[arg-type]
